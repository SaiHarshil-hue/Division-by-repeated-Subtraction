CHIP Divider {
    IN dividend[16], divisor[16], start;
    OUT quotient[16], remainder[16], done;

    PARTS:

    // Detect a new start signal
    DividerState(in=start, load=true, out=previousStart);
    Not(in=previousStart, out=notPreviousStart);
    And(a=start, b=notPreviousStart, out=newStart);

    // Store divisor only during initialization
    Register16(in=divisor, load=newStart, out=divisorStored);

    // Compare remainder and divisor
    GreaterEqual16(
        a=currentRemainder,
        b=divisorStored,
        ge=canSubtract
    );

    // Subtract divisor
    Sub16(a=currentRemainder, b=divisorStored, out=difference);

    // Increment quotient
    Inc16(in=currentQuotient, out=incremented);

    // Generate zero
    Zero16(out=zero);

    // Initialize quotient or increment it
    Mux16(a=incremented, b=zero, sel=newStart, out=quotientInput);
    Or(a=newStart, b=doIncrement, out=quotientLoad);

    Register16(
        in=quotientInput,
        load=quotientLoad,
        out=currentQuotient
    );

    // Initialize or update remainder
    Mux16(a=difference, b=dividend, sel=newStart, out=remainderInput);
    Or(a=newStart, b=doSubtract, out=remainderLoad);

    Register16(
        in=remainderInput,
        load=remainderLoad,
        out=currentRemainder
    );

    // Connect outputs
    Or16(a=currentRemainder, b=false, out=remainder);
    Or16(a=currentQuotient, b=false, out=quotient);

    // Division control
    DividerControl(
        start=newStart,
        canSubtract=canSubtract,
        running=running,
        nextRunning=nextRunning,
        doSubtract=doSubtract,
        doIncrement=doIncrement,
        done=rawDone
    );

    // Store running state
    Or(a=newStart, b=running, out=runningLoad);

    DividerState(
        in=nextRunning,
        load=runningLoad,
        out=running
    );

    // Store completion status
    Not(in=newStart, out=notNewStart);
    And(a=rawDone, b=notNewStart, out=doneInput);

    Or(a=newStart, b=running, out=doneLoad);

    DividerState(
        in=doneInput,
        load=doneLoad,
        out=done
    );
}
